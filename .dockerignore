# Podman uses .containerignore if present, falling back to this file
# otherwise -- so this one file covers both docker build and podman build.

.git
.github
.venv
venv
__pycache__
*.pyc
build/
dist/
*.egg-info/

# Local dev artifacts / secrets -- never bake these into the image
.env
*.log

# Docs site build output
site/

# Example/working data -- mount these at runtime instead (see
# docker-compose.yml / podman-compose.yml), don't bake them into the image
guide.json
guide.enriched.json
images/
output/
